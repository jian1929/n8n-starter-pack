{
  "name": "OPC模板01 · 线索即时响应（含AI评分占位）",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-instant-response",
        "options": {}
      },
      "id": "wh-01",
      "name": "收到新线索",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "opc-lead-ir"
    },
    {
      "parameters": {
        "jsCode": "// 规范化 + 打分（示例规则；可替换为你的 AI 打分接口）\nconst out = [];\nfor (const item of $input.all()) {\n  const d = item.json || {};\n  const email = String(d.email || '').trim().toLowerCase();\n  const message = String(d.message || '');\n  let score = 40;\n  if (email) score += 15;\n  if (String(d.phone || '').trim()) score += 10;\n  if (/预算|报价|price|budget|尽快|asap|急|this week/i.test(message)) score += 20;\n  if (/了解|看看|随便|just looking|maybe/i.test(message)) score -= 15;\n  score = Math.max(0, Math.min(100, score));\n  out.push({ json: { email, phone: d.phone || '', message, name: d.name || '', score, priority: score >= 70 ? 'high' : 'low', receivedAt: new Date().toISOString() } });\n}\nreturn out;"
      },
      "id": "cd-01",
      "name": "规范化与评分",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": false,
        "options": {}
      },
